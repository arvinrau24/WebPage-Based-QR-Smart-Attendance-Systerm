# Django backend (Railway)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Local PostgreSQL (used when DATABASE_URL is not set)
DB_NAME=smart_attendance
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Railway sets DATABASE_URL automatically when you add PostgreSQL.
# DATABASE_URL=postgres://user:pass@host:port/dbname

# Comma-separated hostnames (Railway domain is added automatically)
ALLOWED_HOSTS=localhost,127.0.0.1

# Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

GROQ_API_KEY=your-groq-api-key

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
